#!/usr/bin/env bash

KUBESCAPE_BIN="$(PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:${HOMEBREW_PREFIX}/bin which kubescape)"

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

case $1 in
    "get")
        kctl_args="${kctl_args} --sort-by=.metadata.creationTimestamp"
    ;;
esac

>&2 echo "[KUBESCAPE @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}"
${KUBESCAPE_BIN} ${kctl_args} $@
