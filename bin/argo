#!/usr/bin/env bash

ARGO_BIN="$(PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:${HOMEBREW_PREFIX}/bin which argo)"

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

>&2 echo "[ARGO @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}/${namespace}"
${ARGO_BIN} ${kctl_args} $@
