#!/usr/bin/env bash

if [ -z ${KUBECTL_VERSION} ]; then
  KUBECTL_BIN="${HOME}/.local/bin/kubectl"
else
  KUBECTL_BIN="${HOME}/.local/bin/kubectl@${KUBECTL_VERSION}"
fi

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

>&2 echo "[KUBECTL @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}/${namespace}"
${KUBECTL_BIN} ${kctl_args} "$@"
