#!/usr/bin/env bash

FLUX_BIN="$(PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:${HOMEBREW_PREFIX}/bin which flux)"

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

>&2 echo "[FLUX @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}/${namespace}"
${FLUX_BIN} ${kctl_args} $@
