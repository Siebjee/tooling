#!/usr/bin/env bash

HELM_BIN="$(PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:${HOMEBREW_PREFIX}/bin which helm)"

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

>&2 echo "[HELM @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}/${namespace}"
${HELM_BIN} ${kctl_args} $@
