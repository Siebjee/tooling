#!/usr/bin/env bash

STERN_BIN="$(PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:${HOMEBREW_PREFIX}/bin which stern)"

source ${TOOLING_ZSH_DIR}/functions/kube_config_wrapper.sh

>&2 echo "[STERN @ $(date "+%Y-%m-%d %H:%M:%S")] Using context: ${context}/${namespace}"
${STERN_BIN} ${kctl_args} "$@"
